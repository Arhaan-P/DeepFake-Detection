# ============================================
# LARGE FILES - DO NOT COMMIT
# ============================================

# Video files
*.mp4
*.avi
*.mov
*.mkv
*.flv
*.wmv

# Data directories and files (large)
data/videos/
data/deepfake/
data/deepfake_videos/
data/augmented_videos/
data/*.npy
data/*.npz
data/subject_map.json
# NOTE: data/gait_features/ (enrolled_identities.pkl, gait_features.pkl) is
# tracked deliberately so a trained setup is portable across machines.

# Model files (large, retrain instead)
models/*.pt
models/*.h5
models/*.keras
models/*.joblib
models/*.pkl

# Results and outputs (regenerate with scripts)
outputs/tensorboard/
outputs/evaluation/
outputs/loocv/
outputs/ablation/
outputs/gradcam/
outputs/training_history.json
# NOTE: outputs/checkpoints/ and outputs/model_config.json are tracked
# deliberately so the trained model is portable across machines.
results/
output/
logs/

# TensorBoard events
events.out.tfevents.*

# Checkpoints (generic catch-all for other checkpoint dirs, e.g. tensorboard's own)
*.ckpt

